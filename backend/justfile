# Backend tasks — run as `just backend::<recipe>`

# Start the backend dev server (port 8080)
dev:
    ./gradlew bootRun

# Run backend tests (hermetic — Testcontainers MySQL)
test:
    ./gradlew test

# Build the backend production jar
build:
    ./gradlew bootJar

# Install backend dependencies (downloads Gradle wrapper + dependencies)
install:
    ./gradlew --version

# Verify the backend is healthy: run tests and build
verify: test build

# Remove build artifacts
clean:
    ./gradlew clean