# Frontend tasks — run as `just frontend::<recipe>`

# Generate GraphQL types/documents from the backend schema (never hand-edit output)
generate:
    npm run generate

# Install frontend dependencies from the lockfile
install:
    npm ci

# Start the frontend dev server (port 3000)
dev:
    npm run dev

# Build the frontend production bundle
build:
    npm run build

# Run frontend tests with Vitest
test:
    npm run test

# Verify the frontend is healthy: run tests and build the production bundle
verify: test build

# Remove build artifacts (.output, dist)
clean:
    rm -rf .output dist
