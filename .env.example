# Chafgram — Environment Variables
# Copy to .env (git-ignored) and adjust values as needed.
# All variables have defaults for local dev; override for production/shared setups.

# =============================================================================
# FRONTEND (TanStack Start) — used by the BFF proxy
# =============================================================================
# Backend API URL for the BFF proxy (frontend/src/lib/backend-proxy.ts)
# The browser never sees this; only the server functions call it.
CHAFGRAM_API_URL=http://localhost:8080

# =============================================================================
# BACKEND (Spring Boot) — datasource
# =============================================================================
# Local dev MySQL (matches compose.yaml defaults).
# Override with SPRING_DATASOURCE_* for shared/production DBs.
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/chafgram?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=chafgram
SPRING_DATASOURCE_PASSWORD=chafgram

# =============================================================================
# BACKEND — WebAuthn / Passkeys (FR-1.6)
# =============================================================================
# Relying Party ID (domain only, no scheme/port). Must match the browser's
# effective domain. For local dev: "localhost".
CHAFGRAM_WEBAUTHN_RP_ID=localhost

# Comma-separated list of allowed origins for WebAuthn ceremonies.
# Must include the frontend origin exactly.
CHAFGRAM_WEBAUTHN_ALLOWED_ORIGINS=http://localhost:3000

# =============================================================================
# BACKEND — Account flows / Mail (FR-1.7, BR-10.1)
# =============================================================================
# Frontend base URL used to build links in verification/reset emails.
CHAFGRAM_APP_URL=http://localhost:3000

# Enable SMTP for outbound mail. Default: false (mail logged only).
# When false, no outbound network calls are made — safe for air-gapped installs.
CHAFGRAM_MAIL_SMTP_ENABLED=false

# From address for account emails (verification, password reset).
CHAFGRAM_MAIL_FROM=chafgram@localhost

# SMTP settings (only used when CHAFGRAM_MAIL_SMTP_ENABLED=true)
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=25
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_SMTP_AUTH=false
SPRING_MAIL_SMTP_STARTTLS=false

# =============================================================================
# BACKEND — Media storage
# =============================================================================
# Backend media storage: s3 (default, Garage in dev) or local (filesystem).
CHAFGRAM_MEDIA_BACKEND=s3
CHAFGRAM_MEDIA_S3_ENDPOINT=http://localhost:3900
CHAFGRAM_MEDIA_S3_BUCKET=chafgram-media
CHAFGRAM_MEDIA_S3_REGION=garage
# Dev-only throwaway credentials — also used by scripts/garage-init.sh.
GARAGE_ACCESS_KEY=GK67304d5c49c3278bab342460
GARAGE_SECRET_KEY=d53617c73b0711ab876d08d4072f4f45a65b7f0a150fcf00d38133737d0040f3
# Only used when CHAFGRAM_MEDIA_BACKEND=local.
CHAFGRAM_MEDIA_STORAGE_ROOT=./media-data

# =============================================================================
# NOTES
# =============================================================================
# - .env is loaded by `just` (dotenv-load := true in justfile) and by Spring Boot
#   via the Spring Boot Maven plugin's default behavior.
# - For production, prefer setting real env vars over .env (more secure).
# - Never commit real credentials. This file is tracked; .env is git-ignored.
# - compose.yaml also sets some of these for local dev (MySQL, Garage).
# - Garage (S3-compatible object storage) uses separate config in scripts/garage-init.sh
#   and config/garage.toml — not env-based.