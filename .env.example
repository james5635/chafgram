# Chafgram — local dev environment overrides.
# Copy to `.env` (gitignored) and adjust. Values below are the dev-only
# throwaway defaults the repo ships; override them for anything shared.
# Never commit real credentials — `.env` is in .gitignore for a reason.
#
# Who reads which block:
#   * docker compose auto-loads this file for the compose.yaml services
#     (MYSQL_PORT/…, GARAGE_*)
#   * the JVM does NOT auto-load `.env` — SPRING_DATASOURCE_* / CHAFGRAM_*
#     are read from the real process environment, so export them (or rely on
#     the application.properties defaults, which match the compose MySQL).

# --- Spring datasource (matches compose.yaml's MySQL dev credentials) ---
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/chafgram?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=chafgram
SPRING_DATASOURCE_PASSWORD=chafgram

# --- Test datasource ---
# Not needed: integration tests are hermetic and start their own throwaway
# MySQL 8 container via Testcontainers (Docker must be running).

# --- WebAuthn relying party (must match where the frontend is served) ---
CHAFGRAM_WEBAUTHN_RP_ID=localhost
CHAFGRAM_WEBAUTHN_ALLOWED_ORIGINS=http://localhost:3000

# --- Account flows (optional): email verification + password reset ---
# Base URL used to build the links in those mails.
CHAFGRAM_APP_URL=http://localhost:3000
# Mail is written to the application log unless this is turned on.
CHAFGRAM_MAIL_SMTP_ENABLED=false
CHAFGRAM_MAIL_FROM=chafgram@localhost
# Only needed when CHAFGRAM_MAIL_SMTP_ENABLED=true
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=25
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_SMTP_AUTH=false
SPRING_MAIL_SMTP_STARTTLS=false

# --- compose.yaml MySQL service ---
MYSQL_PORT=3306
MYSQL_DATABASE=chafgram
MYSQL_USER=chafgram
MYSQL_PASSWORD=chafgram
MYSQL_ROOT_PASSWORD=root

# --- Garage (S3-compatible dev object storage; passed to the garage service) ---
# Dev-only throwaway credentials. Generate your own with: openssl rand -hex 32
GARAGE_RPC_SECRET=4ed9483a69dd3e3e78df949608f020fb10858f5c56e572dfc30c958335919cec
GARAGE_ADMIN_TOKEN=c550efd14088f04414caa03396fc2785baa912ee9f3bbef18dea0612d8cac0f6
GARAGE_METRICS_TOKEN=61ac6d636d85aec61b79a8d16fb1b22a
# Dev access key imported by garage-init (bucket `chafgram-media`, read/write)
GARAGE_ACCESS_KEY=GK67304d5c49c3278bab342460
GARAGE_SECRET_KEY=d53617c73b0711ab876d08d4072f4f45a65b7f0a150fcf00d38133737d0040f3
